@echo off
REM JARVIS Service Installation via NSSM
REM Generated by JARVIS Installer
REM Run as Administrator

set JARVIS_HOME={{ working_dir }}
set JARVIS_VENV={{ venv }}
set JARVIS_PYTHON={{ python_exec }}
set JARVIS_CONFIG={{ config_file }}

REM Check if NSSM exists
where nssm >nul 2>&1
if %errorlevel% neq 0 (
    echo NSSM not found in PATH
    echo Please download from https://nssm.cc/download and add to PATH
    pause
    exit /b 1
)

echo Installing JARVIS service via NSSM...

nssm install "JARVIS" "{{ python_exec }}" "-m jarvis"
if errorlevel 1 (
    echo Failed to install service
    pause
    exit /b 1
)

nssm set "JARVIS" AppDirectory "{{ working_dir }}"
nssm set "JARVIS" AppParameters "-m jarvis"
nssm set "JARVIS" AppEnvironmentExtra "PATH={{ venv_bin }};%PATH%"
nssm set "JARVIS" AppEnvironmentExtra "PYTHONPATH={{ working_dir }}\src"
nssm set "JARVIS" AppEnvironmentExtra "JARVIS_CONFIG={{ config_file }}"
nssm set "JARVIS" Start SERVICE_AUTO_START
nssm set "JARVIS" DisplayName "JARVIS CyberBot Assistant"
nssm set "JARVIS" Description "JARVIS CyberBot Assistant - Voice Assistant with Computer Control"
nssm set "JARVIS" ErrorControl 1
nssm set "JARVIS" Restart 1
nssm set "JARVIS" RestartDelay 10000

echo Starting JARVIS service...
nssm start "JARVIS"
if errorlevel 1 (
    echo Warning: Service installed but failed to start
) else (
    echo JARVIS service installed and started successfully
)

echo.
echo Service management commands:
echo   nssm start JARVIS
echo   nssm stop JARVIS
echo   nssm restart JARVIS
echo   nssm status JARVIS
echo   nssm remove JARVIS confirm
echo.

pause